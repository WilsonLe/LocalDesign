{
  "name": "localdesign",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4179 --strictPort",
    "build": "npm run check:skills && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4179 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:skills": "node scripts/check-skills.mjs && vitest run tests/skills.test.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "format": "prettier --write src tests scripts docs .agents AGENTS.md README.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md package.json tsconfig.json vite.config.ts playwright.config.ts .github",
    "format:check": "prettier --check src tests scripts docs .agents AGENTS.md README.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md package.json tsconfig.json vite.config.ts playwright.config.ts .github"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@noble/hashes": "2.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "fflate": "0.8.3",
    "fontkit": "3.0.0",
    "harfbuzzjs": "1.6.4",
    "idb": "8.0.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
